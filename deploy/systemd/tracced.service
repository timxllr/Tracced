[Unit]
Description=Tracced FastAPI Backend Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tracced/backend
EnvironmentFile=/var/www/tracced/backend/.env
ExecStart=/var/www/tracced/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5s

# Sicherheits-Härtung (ProtectHome nicht gesetzt, da Backend unter /home liegen kann)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
