# PostgreSQL Verbindung (Standard lokaler Dienst oder Server)
# Format: postgresql+asyncpg://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
DATABASE_URL=postgresql+asyncpg://tracced_user:dein_sicheres_passwort@127.0.0.1:5432/tracced_db

# Sicherheit & Sitzungsverwaltung
# Erzeuge einen sicheren Key via: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=aendere_mich_zu_einem_zufaelligen_sicheren_hex_key_mit_mindestens_32_zeichen

# Server-Konfiguration
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000

# CORS & Sicherheit
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_COOKIES=false
